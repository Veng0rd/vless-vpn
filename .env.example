TZ=Europe/Amsterdam
THREEXUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v2.8.11

# 3x-ui panel bootstrap login.
# Official Docker docs use admin/admin on first start.
PANEL_API_BASE=http://127.0.0.1:2053
PANEL_WEB_BASE_PATH=
PANEL_USERNAME=admin
PANEL_PASSWORD=admin

# Public server address used in generated client links.
OUTPUT_HOST=SERVER_PUBLIC_IP

# Main VLESS Reality inbound.
VLESS_PORT=443
VLESS_REMARK=nl-reality-main
VLESS_CLIENT_EMAIL=primary@local
VLESS_UUID=

# Reality donor/SNI. Domain is NOT required for basic Reality mode.
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com,dl.google.com,www.apple.com,gateway.icloud.com
REALITY_FINGERPRINT=chrome
REALITY_SPIDER_X=/
REALITY_SHORT_IDS=

# Sync interval for runetfreedom routing artifacts.
RULES_SYNC_INTERVAL_SECONDS=21600
